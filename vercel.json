{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "it-helpdesk-beige-five\\.vercel\\.app" }],
      "headers": { "Location": "https://it-helpdesk-pondz2.vercel.app/$1" },
      "status": 308
    },
    {
      "src": "/",
      "dest": "frontend/index.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
